    "linkify-it": "5.0.2",
    "path-to-regexp": "0.1.13",
    "fast-xml-builder": "1.1.7",
    "uuid": "11.1.1",
    "@hapi/wreck": "18.1.2",
    "body-parser": "1.20.6",
    "markdown-it": "14.3.1",
    "yaml": "2.9.1",
    "follow-redirects": "1.16.0",
    "@babel/core": "7.29.6",
    "nanoid": "3.3.18",
    "sanitize-html": "2.17.7",
    "compression": "1.8.2",
    "source-map-js": "1.2.2",
    "moment": "2.31.0",
    "joi@18": "18.2.9",
    "undici@6": "6.29.1",
    "undici@7": "7.29.1",
    "proxy-addr": "2.0.8",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
