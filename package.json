    },
    "jsonwebtoken": "9.0.3",
    "cross-spawn": "7.0.6",
    "trim": "0.0.3",
    "validator": "13.15.22",
    "fast-xml-parser": "5.7.0",
    "qs": "6.16.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "rewire": {
