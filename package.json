{
  "name": "@mojaloop/bulk-api-adapter",
  "version": "17.3.0",
  "private": true,
  "description": "Mojaloop Bulk API Adapter",
  "license": "Apache-2.0",
  "author": "ModusBox",
  "contributors": [
    "Georgi Georgiev <georgi.georgiev@modusbox.com>",
    "Miguel de Barros <miguel.debarros@modusbox.com>",
    "Sam Kummary <sam@mojaloop.io",
    "Steven Oderayi <steven.oderayi@modusbox.com>",
    "Valentin Genev <valentin.genev@modusbox.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/mojaloop/bulk-api-adapter.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=18.x"
  },
  "imports": {
    "#src/*": "./src/*.js",
    "#test/*": "./test/*.js"
  },
  "main": "./src/api/index.js",
  "pre-commit": [
    "lint",
    "dep:check",
    "test"
  ],
  "scripts": {
    "start": "npm run start:api",
    "start:api": "node src/api/index.js",
    "watch:api": "npx nodemon src/api/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit",
    "test:all": "npm run test",
    "test:unit": "tape 'test/unit/**/*.test.js' | tap-spec",
    "test:xunit": "tape 'test/unit/**/*.test.js' | tap-xunit",
    "test:coverage": "npx nyc --reporter=lcov --reporter=text-summary tapes -- 'test/unit/**/**.test.js'",
    "test:coverage-check": "npm run test:coverage && nyc check-coverage",
    "test:functional": "echo 'No functional tests defined'",
    "test:integration": "echo 'No integration tests defined'",
    "docker:build": "docker build --build-arg NODE_VERSION=\"$(cat .nvmrc)-alpine\" -t mojaloop/bulk-api-adapter:local .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.yml stop",
    "docker:rm": "docker-compose -f docker-compose.yml rm -f -v",
    "docker:down": "docker-compose -f docker-compose.yml down -v",
    "docker:clean": "docker-compose -f docker-compose.yml down --rmi local",
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "dep:check": "npx ncu -e 2",
    "dep:update": "npx ncu -u",
    "release": "npx standard-version --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'"
  },
  "dependencies": {
    "@hapi/basic": "7.0.2",
    "@hapi/boom": "10.0.1",
    "@hapi/catbox": "12.1.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/good": "9.0.1",
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "@mojaloop/central-services-error-handling": "13.2.1",
    "@mojaloop/central-services-health": "15.2.4",
    "@mojaloop/central-services-logger": "11.10.7",
    "@mojaloop/central-services-metrics": "12.8.9",
    "@mojaloop/central-services-shared": "^18.26.2",
    "@mojaloop/central-services-stream": "11.12.0",
    "@mojaloop/event-sdk": "14.8.6",
    "@mojaloop/object-store-lib": "12.2.5",
    "@mojaloop/sdk-standard-components": "19.19.3",
    "@now-ims/hapi-now-auth": "2.1.0",
    "axios": "1.20.0",
    "blipp": "4.0.2",
    "commander": "15.0.0",
    "hapi-auth-bearer-token": "8.0.0",
    "hapi-swagger": "17.3.2",
    "immutable": "5.1.9",
    "joi": "17.13.8",
    "mongo-uri-builder": "^4.0.0",
    "mustache": "4.2.0",
    "parse-strings-in-object": "2.0.0",
    "rc": "1.2.8",
    "uuid4": "2.0.3"
  },
  "overrides": {
    "ajv": "8.20.0",
    "eslint": {
      "ajv": "6.14.0"
    },
    "@eslint/eslintrc": {
      "ajv": "6.14.0"
    },
    "form-data": "4.0.6",
    "on-headers": "1.1.0",
    "ansi-regex": "5.0.1",
    "postcss": "8.5.26",
    "ejs": "3.1.10",
    "shins": {
      "ajv": "8.20.0",
